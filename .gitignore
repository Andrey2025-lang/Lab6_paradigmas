# ═══════════════════════════════════════════════════
# Shared workspace .gitignore
# ═══════════════════════════════════════════════════

# ── Personal / machine-specific (never shared) ────
/Machine/
/temp/
/Repos/*
!/Repos/AGENTS.md

# Estado local de la interfaz de Obsidian (las notas sí se conservan)
/brain/.obsidian/workspace.json

# ── Personal knowledge bases (optional: remove a line to share yours) ──
# To keep your personal KB private, add it here:
# /Knowledge/YourName-Brain/

# ── OS / editor noise ─────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Node / Python artifacts ───────────────────────
node_modules/
__pycache__/
*.pyc
.env
.env.local
.env.*
!.env.example

# Informes generados por pruebas
playwright-report/
test-results/
blob-report/
